# backend-new environment template
# Copy this file to .env and fill in the real local values.
# 所有值均为占位符，请勿提交真实凭据到版本库。

# ── 数据库 ──
# PostgreSQL 连接串（Supabase 云端或本地）
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ── 服务 ──
# 后端监听端口（被占时自动 +1，最多试 30 个）
PORT=3100
# 部署环境优先端口（DEPLOY_RUN_PORT > PORT > 3100）
# DEPLOY_RUN_PORT=3100
# 监听地址（默认 0.0.0.0）
# HOST=0.0.0.0
# CORS 跨域白名单（逗号分隔，支持 * 通配；不设则允许所有来源）
# ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003

# ── 认证 ──
# JWT 签名密钥（生产环境必须更换为强随机字符串）
JWT_SECRET=change-me-to-a-strong-random-secret

# ── Supabase（可选，用于 Storage / Auth 等云端能力）──
# 若仅用 PostgreSQL 直连，以下四项可留空
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
