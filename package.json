{
  "name": "cxq-new-backend",
  "private": true,
  "version": "0.1.0",
  "description": "村居换届系统新后端，模块化单体起步骨架",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env --import tsx/esm src/server.ts",
    "migrate": "node --env-file=.env --import tsx/esm src/migrate.ts",
    "migrate:file": "node --env-file=.env --import tsx/esm src/migrate-file.ts",
    "seed:templates": "node --env-file=.env seed-templates.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
